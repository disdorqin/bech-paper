{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "signed_mass_china5_run_manifest.v1",
  "title": "Signed-mass China-5 run manifest",
  "description": "One per execution of runner.py run --execute. Records what was fitted, under which registry values, from which frozen inputs. It is a provenance record, not a result: the per-fit files under 03_component_screen/ and 04_frozen_method/ carry the numbers. Written by runner._run_manifest and validated against this file by tests/test_manifest_schema.py.",
  "type": "object",
  "definitions": {
    "switch_vector_all_on": {
      "type": "object",
      "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
      "additionalProperties": false,
      "properties": {
        "shape_semantic_context": {"const": true},
        "use_tcn": {"const": true},
        "untied_amplitude_heads": {"const": true},
        "rare_mass_sampling": {"const": true}
      }
    }
  },
  "required": [
    "schema", "generated_utc", "cells", "configurations", "config_switches",
    "seeds", "dev_eval_days", "dev_eval_authorized", "training",
    "loss_weights", "oof_rule", "thresholds_source", "core", "environment",
    "git", "n_fits", "fits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "signed_mass_china5_run_manifest.v1"
    },
    "generated_utc": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp written at manifest time."
    },
    "cells": {
      "type": "array",
      "description": "Readiness-filtered execution plan: only cells whose HOST_INPUT_READINESS status admits fitting appear here.",
      "items": {
        "type": "object",
        "required": ["market", "host"],
        "properties": {
          "market": {"enum": ["GANSU_DA", "SHANDONG_DA", "SHAANXI_DA", "NINGXIA_DA", "QINGHAI_DA"]},
          "host": {"enum": ["PatchTST", "TimeMixer", "iTransformer", "LSTM"]}
        }
      }
    },
    "configurations": {
      "type": "array",
      "description": "Registered configuration names actually fitted, in registry order.",
      "items": {"enum": ["FULL", "NO_SHAPE_CONTEXT", "NO_TCN", "TIED_AMPLITUDE", "NO_RARE_MASS"]},
      "minItems": 1
    },
    "config_switches": {
      "type": "object",
      "description": "The exact switch state of every configuration, so an ablation can be reconstructed from the manifest alone. The five registered configurations are pinned to their registered vectors; any other name must still carry a well-formed switch vector, which makes an unregistered configuration visible rather than silent.",
      "additionalProperties": {
        "type": "object",
        "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
        "additionalProperties": false,
        "properties": {
          "shape_semantic_context": {"type": "boolean"},
          "use_tcn": {"type": "boolean"},
          "untied_amplitude_heads": {"type": "boolean"},
          "rare_mass_sampling": {"type": "boolean"}
        }
      },
      "properties": {
        "FULL": {"$ref": "#/definitions/switch_vector_all_on"},
        "NO_SHAPE_CONTEXT": {
          "type": "object",
          "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
          "additionalProperties": false,
          "properties": {
            "shape_semantic_context": {"const": false},
            "use_tcn": {"const": true},
            "untied_amplitude_heads": {"const": true},
            "rare_mass_sampling": {"const": true}
          }
        },
        "NO_TCN": {
          "type": "object",
          "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
          "additionalProperties": false,
          "properties": {
            "shape_semantic_context": {"const": true},
            "use_tcn": {"const": false},
            "untied_amplitude_heads": {"const": true},
            "rare_mass_sampling": {"const": true}
          }
        },
        "TIED_AMPLITUDE": {
          "type": "object",
          "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
          "additionalProperties": false,
          "properties": {
            "shape_semantic_context": {"const": true},
            "use_tcn": {"const": true},
            "untied_amplitude_heads": {"const": false},
            "rare_mass_sampling": {"const": true}
          }
        },
        "NO_RARE_MASS": {
          "type": "object",
          "required": ["shape_semantic_context", "use_tcn", "untied_amplitude_heads", "rare_mass_sampling"],
          "additionalProperties": false,
          "properties": {
            "shape_semantic_context": {"const": true},
            "use_tcn": {"const": true},
            "untied_amplitude_heads": {"const": true},
            "rare_mass_sampling": {"const": false}
          }
        }
      }
    },
    "seeds": {
      "type": "array",
      "items": {"type": "integer"},
      "description": "Registered training seeds. Fixed globally; never chosen per cell."
    },
    "dev_eval_days": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of DEV_EVAL days evaluated. Must be 0 in the harness-landing round; any positive value requires the execution authorization token."
    },
    "dev_eval_authorized": {
      "type": "boolean",
      "description": "True only when the authorization token was supplied. A manifest with dev_eval_days > 0 and this false is invalid."
    },
    "training": {
      "type": "object",
      "description": "Registered optimiser and schedule. Identical for every cell.",
      "required": ["lr", "weight_decay", "batch_size", "max_epochs", "patience", "seeds"],
      "additionalProperties": true,
      "properties": {
        "lr": {"const": 0.001},
        "weight_decay": {"const": 0.0001},
        "batch_size": {"const": 32},
        "max_epochs": {"const": 50},
        "patience": {"const": 8},
        "seeds": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "loss_weights": {
      "type": "object",
      "description": "Registered loss weights, plus the shape metric selector. These are not yet scientifically frozen and are recorded so that any future change is visible in every manifest written after it.",
      "required": ["repair", "shape", "amplitude", "shape_metric"],
      "additionalProperties": false,
      "properties": {
        "repair": {"type": "number", "minimum": 0},
        "shape": {"type": "number", "minimum": 0},
        "amplitude": {"type": "number", "minimum": 0},
        "shape_metric": {
          "enum": ["wasserstein", "l1"],
          "description": "Only the two metrics src/core actually implements. The registered default is wasserstein; l1 is the screened ablation."
        }
      }
    },
    "oof_rule": {
      "type": "object",
      "description": "The global fold rule. A function of POST_TRAIN volume only, never of a market name.",
      "required": ["min_train_days", "min_holdout_days", "max_folds", "inner_val_fraction"],
      "additionalProperties": false,
      "properties": {
        "min_train_days": {"type": "integer", "minimum": 1},
        "min_holdout_days": {"type": "integer", "minimum": 1},
        "max_folds": {"type": "integer", "minimum": 1, "maximum": 5},
        "inner_val_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "thresholds_source": {
      "type": "string",
      "description": "Repository-relative path of the frozen THRESHOLD_FREEZE.json. Never recomputed per Host or per method."
    },
    "core": {
      "type": "object",
      "description": "Provenance of the scientific object: per-file sha256 of src/core plus the tree digest.",
      "required": ["core_package", "core_tree_digest", "core_module_files", "exports_used"],
      "additionalProperties": false,
      "properties": {
        "core_package": {"const": "src/core"},
        "core_tree_digest": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "core_module_files": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        },
        "exports_used": {
          "type": "array",
          "items": {"type": "string"},
          "description": "The audited consumption surface. Must equal core_bridge.CORE_EXPORTS_USED exactly."
        }
      }
    },
    "environment": {
      "type": "object",
      "description": "Interpreter and library versions at run time.",
      "additionalProperties": {"type": "string"}
    },
    "git": {
      "type": "object",
      "description": "Repository state at run time. A dirty tree is recorded, not refused: the manifest is what makes it visible.",
      "required": ["branch", "head", "dirty"],
      "additionalProperties": true,
      "properties": {
        "branch": {"type": "string"},
        "head": {"type": "string"},
        "dirty": {"type": "boolean"}
      }
    },
    "n_fits": {
      "type": "integer",
      "minimum": 0,
      "description": "Length of fits. Equals len(cells) x len(configurations) x len(seeds)."
    },
    "fits": {
      "type": "array",
      "description": "One summary row per (cell, configuration, seed) fit. The full record lives in the per-fit evidence file.",
      "items": {
        "type": "object",
        "required": ["config", "market", "host", "seed", "alpha", "oof_correction_sha256"],
        "additionalProperties": false,
        "properties": {
          "config": {"enum": ["FULL", "NO_SHAPE_CONTEXT", "NO_TCN", "TIED_AMPLITUDE", "NO_RARE_MASS"]},
          "market": {"enum": ["GANSU_DA", "SHANDONG_DA", "SHAANXI_DA", "NINGXIA_DA", "QINGHAI_DA"]},
          "host": {"enum": ["PatchTST", "TimeMixer", "iTransformer", "LSTM"]},
          "seed": {"type": "integer"},
          "alpha": {
            "type": "number",
            "minimum": 0,
            "description": "The single nonnegative pooled MAE scalar for this fit. Never negative, never per-instance."
          },
          "oof_correction_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        }
      }
    }
  }
}
